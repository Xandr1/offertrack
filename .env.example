# Copy this file to .env and override values if needed.

# Database / local codegen
OFFERTRACK_RUN_MODE=server
DB_USER=offertrack
DB_PASSWORD=offertrack
DATABASE_URL=jdbc:postgresql://localhost:5432/offertrack

# Docker Compose / Postgres
POSTGRES_DB=offertrack
POSTGRES_USER=offertrack
POSTGRES_PASSWORD=offertrack

# Redis / AI draft cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_CONNECT_TIMEOUT=1s
REDIS_TIMEOUT=1s
AI_DRAFT_CACHE_ENABLED=true
AI_DRAFT_CACHE_TTL=24h

# Redis-backed endpoint rate limiting. Rotating the key secret resets effective counters.
RATE_LIMIT_KEY_SECRET=local-dev-rate-limit-key-secret-change-me
RATE_LIMIT_FAIL_OPEN=true
RATE_LIMIT_LOGIN_EMAIL_MAX_ATTEMPTS=5
RATE_LIMIT_LOGIN_EMAIL_WINDOW=15m
RATE_LIMIT_LOGIN_IP_MAX_ATTEMPTS=20
RATE_LIMIT_LOGIN_IP_WINDOW=15m
RATE_LIMIT_REGISTRATION_EMAIL_MAX_ATTEMPTS=3
RATE_LIMIT_REGISTRATION_EMAIL_WINDOW=1h
RATE_LIMIT_REGISTRATION_IP_MAX_ATTEMPTS=5
RATE_LIMIT_REGISTRATION_IP_WINDOW=1h
RATE_LIMIT_VERIFICATION_RESEND_EMAIL_MAX_ATTEMPTS=3
RATE_LIMIT_VERIFICATION_RESEND_EMAIL_WINDOW=1h
RATE_LIMIT_VERIFICATION_RESEND_IP_MAX_ATTEMPTS=10
RATE_LIMIT_VERIFICATION_RESEND_IP_WINDOW=1h
RATE_LIMIT_FORGOT_PASSWORD_EMAIL_MAX_ATTEMPTS=5
RATE_LIMIT_FORGOT_PASSWORD_EMAIL_WINDOW=1h
RATE_LIMIT_FORGOT_PASSWORD_IP_MAX_ATTEMPTS=20
RATE_LIMIT_FORGOT_PASSWORD_IP_WINDOW=1h
RATE_LIMIT_RESET_PASSWORD_TOKEN_MAX_ATTEMPTS=10
RATE_LIMIT_RESET_PASSWORD_TOKEN_WINDOW=1h
RATE_LIMIT_RESET_PASSWORD_IP_MAX_ATTEMPTS=20
RATE_LIMIT_RESET_PASSWORD_IP_WINDOW=1h
RATE_LIMIT_AI_USER_MINUTE_MAX_ATTEMPTS=10
RATE_LIMIT_AI_USER_MINUTE_WINDOW=1m
RATE_LIMIT_AI_USER_DAY_MAX_ATTEMPTS=100
RATE_LIMIT_AI_USER_DAY_WINDOW=1d

# Docker Compose / MinIO
MINIO_ROOT_USER=offertrack
MINIO_ROOT_PASSWORD=offertrack123

# Auth
JWT_SECRET=change-me-change-me-change-me-change-me-change-me
JWT_ACCESS_TOKEN_TTL=48h
# Production should set this separately from JWT_SECRET. If omitted locally, the API falls back to app.jwt.secret.
OAUTH_COOKIE_SECRET=
AUTH_COOKIE_NAME=access_token
AUTH_COOKIE_PATH=/
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Lax

# Google OAuth
# Real Google login requires real local or production values. The API uses dummy defaults only so Spring can register the OAuth client in local/test environments.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Web
APP_WEB_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
SERVER_FORWARD_HEADERS_STRATEGY=none
APP_ENV=local
NEXT_PUBLIC_API_URL=http://localhost:8080

# AI service
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_TIMEOUT_SECONDS=30
AI_SERVICE_FETCH_TIMEOUT_SECONDS=10
AI_SERVICE_MAX_RESPONSE_BYTES=10000000
AI_SERVICE_MAX_JOB_TEXT_CHARS=18000
AI_SERVICE_MAX_REDIRECTS=5
AI_SERVICE_ALLOWED_HOSTS=localhost,127.0.0.1,ai-service
AI_SERVICE_DOCS_ENABLED=true
AI_SERVICE_BASE_URL=http://localhost:8000
AI_SERVICE_INTERNAL_API_KEY=local-dev-ai-service-key
AI_SERVICE_AUTH_MODE=internal-key
AI_SERVICE_AUDIENCE=

# Email / local Mailpit
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=no-reply@offertrack.local
