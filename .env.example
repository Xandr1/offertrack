# Copy this file to .env and override values if needed.

# Database / local codegen
DB_USER=offertrack
DB_PASSWORD=offertrack
DATABASE_URL=jdbc:postgresql://localhost:5432/offertrack

# Docker Compose / Postgres
POSTGRES_DB=offertrack
POSTGRES_USER=offertrack
POSTGRES_PASSWORD=offertrack

# Docker Compose / MinIO
MINIO_ROOT_USER=offertrack
MINIO_ROOT_PASSWORD=offertrack123

# Auth
JWT_SECRET=change-me-for-local-dev

# Web
APP_WEB_URL=http://localhost:3000

# Email / local Mailpit
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=no-reply@offertrack.local
