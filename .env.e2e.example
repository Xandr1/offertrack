# Deterministic, non-production values used only by scripts/e2e/run-e2e.sh.
SPRING_PROFILES_ACTIVE=e2e
SERVER_PORT=18080

DATABASE_URL=jdbc:postgresql://127.0.0.1:55432/offertrack_e2e
DB_USER=offertrack_e2e
DB_PASSWORD=offertrack_e2e_password
POSTGRES_DB=offertrack_e2e
POSTGRES_USER=offertrack_e2e
POSTGRES_PASSWORD=offertrack_e2e_password

REDIS_HOST=127.0.0.1
REDIS_PORT=56379
REDIS_CONNECT_TIMEOUT=2s
REDIS_TIMEOUT=2s

JWT_SECRET=e2e-jwt-secret-not-for-production-0123456789abcdef
JWT_ACCESS_TOKEN_TTL=1h
OAUTH_COOKIE_SECRET=e2e-oauth-secret-not-for-production-fedcba9876543210
GOOGLE_CLIENT_ID=e2e-google-client-id
GOOGLE_CLIENT_SECRET=e2e-google-client-secret

APP_WEB_URL=http://127.0.0.1:13000
CORS_ALLOWED_ORIGINS=http://127.0.0.1:13000
AUTH_COOKIE_NAME=access_token
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Lax
AUTH_COOKIE_PATH=/

AI_SERVICE_BASE_URL=http://127.0.0.1:58000
AI_SERVICE_INTERNAL_API_KEY=e2e-ai-internal-key-not-for-production-0123456789
AI_DRAFT_CACHE_ENABLED=false

SMTP_HOST=127.0.0.1
SMTP_PORT=51025
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=e2e@offertrack.invalid

RATE_LIMIT_KEY_SECRET=e2e-rate-limit-key-not-for-production-0123456789abcdef
RATE_LIMIT_FAIL_OPEN=false

APP_ENV=e2e
NEXT_PUBLIC_API_URL=http://127.0.0.1:18080
E2E_BASE_URL=http://127.0.0.1:13000
