**

!Dockerfile
!Dockerfile.dockerignore
!docker-entrypoint.sh
!pyproject.toml
!pylock.toml
!pylock.toml.sha256
!app/
!app/**

# Final deny rules for repository-local secrets and non-runtime artifacts. These
# must remain after the app allow rule so a nested file cannot be re-included.
app/.env*
app/**/.env*
app/**/*.pem
app/**/*.key
app/**/*.p12
app/**/*.pfx
app/**/id_rsa*
app/**/id_ed25519*
app/**/*credentials*.json
app/**/*service-account*.json
app/**/*service_account*.json
app/**/test/
app/**/tests/
app/**/.pytest_cache/
app/**/.ruff_cache/
app/**/.mypy_cache/
app/**/.pyright/
app/**/__pycache__/
app/**/*.py[cod]
app/**/test.py
app/**/test_*.py
app/**/*_test.py
app/**/conftest.py
app/**/.coverage*
app/**/htmlcov/
